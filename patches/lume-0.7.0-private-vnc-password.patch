diff --git a/libs/lume/tests/PrivateVNCPasswordTests.swift b/libs/lume/tests/PrivateVNCPasswordTests.swift
new file mode 100644
index 000000000..41e34c834
--- /dev/null
+++ b/libs/lume/tests/PrivateVNCPasswordTests.swift
@@ -0,0 +1,59 @@
+import Darwin
+import Foundation
+import Testing
+@testable import lume
+
+@Test("Private VNC file reader rejects unsafe files and preserves URL-safe passwords")
+func privateVNCFilePermissions() throws {
+    let dir = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+    try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+    defer { try? FileManager.default.removeItem(at: dir) }
+    let file = dir.appendingPathComponent("password")
+    try Data("Ab09-._~".utf8).write(to: file)
+    chmod(file.path, 0o600)
+    #expect(try PrivateVNCPassword.read(file.path) == "Ab09-._~")
+    chmod(file.path, 0o644)
+    #expect(throws: (any Error).self) { try PrivateVNCPassword.read(file.path) }
+    chmod(file.path, 0o600)
+    let link = dir.appendingPathComponent("link")
+    try FileManager.default.createSymbolicLink(at: link, withDestinationURL: file)
+    #expect(throws: (any Error).self) { try PrivateVNCPassword.read(link.path) }
+    #expect(throws: (any Error).self) { try PrivateVNCPassword.read("relative") }
+    #expect(throws: (any Error).self) { try PrivateVNCPassword.read(dir.path) }
+    for value in ["short", "toolong12", "Ab09/._~", "Ab09%._~", "Ab09#._~"] {
+        try Data(value.utf8).write(to: file)
+        chmod(file.path, 0o600)
+        #expect(throws: (any Error).self) { try PrivateVNCPassword.read(file.path) }
+    }
+}
+
+@Test("Every allowed VNC character survives the same URLComponents parsing used by Lume")
+func privateVNCURLRoundTrip() throws {
+    for char in "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~" {
+        let password = String(repeating: String(char), count: 8)
+        let raw = "vnc://:\(password)@127.0.0.1:57279"
+        let url = try #require(URLComponents(string: raw.replacingOccurrences(of: "vnc://", with: "http://")))
+        #expect(url.password == password)
+        #expect(url.host == "127.0.0.1")
+        #expect(url.port == 57279)
+    }
+}
+
+@Test("Detached VNC child receives only the file path, never its secret")
+func privateVNCDetachedArguments() {
+    let child = DetachedVMRunner.childArguments(from: ["lume", "run", "guest", "--detach", "--vnc-password-file", "/private/password"])
+    #expect(child.contains("--vnc-password-file"))
+    #expect(child.contains("/private/password"))
+    #expect(!child.contains("--vnc-password"))
+    #expect(!child.contains("--detach"))
+}
+
+@Test("OwnMachine creation accepts only listener-free verification")
+func privateVNCCreationPolicy() throws {
+    let command = try Create.parse(["fresh-vm", "--unattended", "tahoe", "--verification-vnc", "disabled"])
+    #expect(command.verificationVNC == .disabled)
+    #expect(throws: (any Error).self) {
+        let unsafe = try Create.parse(["fresh-vm", "--verification-vnc", "enabled"])
+        try unsafe.validate()
+    }
+}
