diff --git a/libs/lume/src/Commands/PrivateVNCPassword.swift b/libs/lume/src/Commands/PrivateVNCPassword.swift
new file mode 100644
index 000000000..4b86293be
--- /dev/null
+++ b/libs/lume/src/Commands/PrivateVNCPassword.swift
@@ -0,0 +1,28 @@
+import Darwin
+import Foundation
+
+enum PrivateVNCPassword {
+    enum Failure: Error, LocalizedError {
+        case unsafeFile
+        var errorDescription: String? { "VNC password file must be an absolute, non-symlink, owner-owned regular file with mode 0600 and exactly eight URL-safe ASCII characters." }
+    }
+
+    static func read(_ path: String) throws -> String {
+        guard path.hasPrefix("/") else { throw Failure.unsafeFile }
+        let fd = Darwin.open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK)
+        guard fd >= 0 else { throw Failure.unsafeFile }
+        defer { Darwin.close(fd) }
+        var info = stat()
+        guard fstat(fd, &info) == 0,
+              info.st_mode & mode_t(S_IFMT) == mode_t(S_IFREG),
+              info.st_mode & 0o777 == 0o600,
+              info.st_uid == getuid(), info.st_nlink == 1, info.st_size == 8
+        else { throw Failure.unsafeFile }
+        var bytes = [UInt8](repeating: 0, count: 9)
+        let count = bytes.withUnsafeMutableBytes { Darwin.read(fd, $0.baseAddress, $0.count) }
+        let alphabet = Swift.Set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~".utf8)
+        guard count == 8, bytes.prefix(8).allSatisfy({ alphabet.contains($0) })
+        else { throw Failure.unsafeFile }
+        return String(decoding: bytes.prefix(8), as: UTF8.self)
+    }
+}
